# ┌─────────────────────────────────────────────────────────────────────────┐
# │  TEMPLATE — THIS FILE IS COMMITTED TO GIT. PLACEHOLDERS ONLY.            │
# │  NEVER put real secrets here. Real values go ONLY in .env.local,        │
# │  which is gitignored. Copy this file to .env.local and fill that in.    │
# └─────────────────────────────────────────────────────────────────────────┘
#
# Edgify — Phase 1 environment. Later phases add OpenRouter / quota / Sentry vars.

# Neon Postgres — use the POOLED connection string (host contains "-pooler").
#
# sslmode=verify-full, not require. In pg 8.x the two behave IDENTICALLY (both parse to `ssl: {}`,
# and Node's TLS defaults then verify the chain and the hostname), but pg 9 / pg-connection-string
# 3 adopt libpq semantics, where `require` means encryption WITHOUT certificate verification. This
# is the user-data database, so the strong behaviour is stated explicitly rather than inherited
# from a default that is scheduled to weaken. Neon's certificates are publicly trusted, so
# verification needs no extra CA config — confirmed against the live endpoint 2026-08-04.
#
# THIS LINE IS WHAT DECIDES. `pg` merges the parsed connection string OVER the explicit `ssl`
# option, so a `sslmode` here overrides lib/db/client.ts; that file's setting applies only if this
# URL carries no `sslmode`. Both are set to the strong value so that removing one cannot quietly
# downgrade the connection.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Better Auth — random 32+ byte secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
# Must match the origin the app is served from.
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (GCP console → APIs & Services → Credentials → OAuth client ID → Web application)
# Authorised redirect URI (local): http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# development | production | test
NODE_ENV="development"

# ── Phase 2: guardrails ──────────────────────────────────────────────────────
# Error reporting (Sentry). Optional — leave blank in dev. A Sentry DSN is a PUBLIC
# ingestion key, not a secret, so NEXT_PUBLIC_ is intentional and safe here.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Per-user daily generation quota, and the time zone whose midnight resets it.
QUOTA_DAILY_LIMIT="30"
QUOTA_TIMEZONE="UTC"

# Fixed-window rate limiting for unauthenticated routes (max requests per window).
RATE_LIMIT_MAX="30"
RATE_LIMIT_WINDOW_MS="60000"

# ── Phase 3: the AI layer ────────────────────────────────────────────────────
# OpenRouter — SERVER-ONLY. Never prefix with NEXT_PUBLIC_ (AGENTS.md rule 1).
OPENROUTER_API_KEY=""
# Model routing. Free-tier ids rotate; keep NON-reasoning instruct ids here (a reasoning model
# burns free quota and delays the first content token). Keep fallbacks on different providers.
OPENROUTER_FREE_MODEL="google/gemma-4-26b-a4b-it:free"
# Changed 2026-08-09: inclusionai/ling-3.0-flash:free was retired from the catalogue. The
# replacement is same-provider — nothing free is currently both non-reasoning AND non-Google — so
# this protects against per-model saturation but not a Google-wide outage. See lib/env.ts.
OPENROUTER_FREE_FALLBACKS="google/gemma-4-31b-it:free"
OPENROUTER_PAID_MODEL="openai/gpt-4o-mini"
# Bump to invalidate the generation cache when prompt templates change.
PROMPT_VERSION="v2"

# ── Phase 7: bounding the graph build's wall clock (docs/09 §1.6) ────────────
# How long ONE graph build may spend walking the degradation ladder before it abandons cleanly to
# status="failed". MUST stay comfortably below the platform request timeout (300s on Cloud Run) —
# the remainder pays for writing the failure and returning a response, which is the whole
# difference between an honest failure and a row stuck on "processing" forever.
# Raise the Cloud Run timeout and you raise this; they are one decision in two places.
GRAPH_BUILD_BUDGET_MS="200000"

# Comma-separated emails allowed to open the internal usage dashboard at /admin/usage.
# FAILS CLOSED: empty means NOBODY, including in development. That page reads every user's spend,
# generation counts and email — a session proves who you are, this decides whether you may see
# other people's data. Leave empty unless you are the operator.
ADMIN_EMAILS=""
